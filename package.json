{
  "name": "dnd",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gultyayev/ngx-virtual-dnd.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ngx-virtual-dnd",
    "build:demo:pages": "ng build --base-href /ngx-virtual-dnd/demo/",
    "docs:dev": "rspress dev --config docs/rspress.config.ts",
    "docs:build": "tsc -p docs/tsconfig.json && rspress build --config docs/rspress.config.ts",
    "docs:preview": "rspress preview --config docs/rspress.config.ts",
    "site:build": "npm run build:lib && npm run build:demo:pages && npm run docs:build && node scripts/assemble-site.js",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p projects/ngx-virtual-dnd/tsconfig.spec.json --noEmit",
    "test": "jest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "perf": "playwright test --config perf/playwright.perf.config.ts",
    "perf:report": "node --experimental-strip-types perf/report.ts",
    "perf:compare": "node --experimental-strip-types perf/compare.ts",
    "perf:test": "node --experimental-strip-types --test \"perf/fixtures/*.test.ts\"",
    "perf:baseline": "npm run perf && cp perf/results/latest.json perf/baselines/baseline.json",
    "storybook": "ng run dnd:storybook",
    "build-storybook": "ng run dnd:build-storybook",
    "release": "node scripts/release.js",
    "release:dry-run": "node scripts/release.js --dry-run",
    "release:alpha": "node scripts/release.js --pre-release",
    "release:alpha:dry-run": "node scripts/release.js --pre-release --dry-run",
    "perf:build:contracts": "node --experimental-strip-types perf/build-contracts.ts",
    "perf:check": "playwright test --config perf/playwright.check.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@ionic/angular": "^9.0.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.29",
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular-devkit/core": "^21.2.29",
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@compodoc/compodoc": "^2.0.0",
    "@epam/eslint-config-angular": "^2.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@rspress/core": "^2.1.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/angular": "^10.6.5",
    "@types/jest": "^30.0.0",
    "angular-eslint": "21.4.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jest-simple-dot-reporter": "^1.0.5",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "svgo": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12",
    "zone.js": "^0.16.3"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true,
    "unrs-resolver": true,
    "@compodoc/compodoc": false,
    "fsevents": false
  }
}
